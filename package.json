{
  "name": "@boxofrules/assets",
  "version": "1.1.0",
  "description": "Box Of Rules assets: the brand kit (marks, fonts, tokens) and, next, every approved plugin image, with a manifest that says what each asset is and where it goes. One source for every site, service, plugin doc and agent.",
  "private": true,
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/boxofrules/assets.git"
  },
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./tokens.css": "./css/tokens.css",
    "./fonts.css": "./css/fonts.css",
    "./tokens.json": "./tokens.json",
    "./manifest.json": "./manifest.json",
    "./marks/*": "./marks/*",
    "./fonts/*": "./fonts/*"
  },
  "files": [
    "index.js",
    "css",
    "fonts",
    "marks",
    "tokens.json",
    "manifest.json",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "check": "node index.js --check"
  }
}
